# ==========================================
# CROP ACREAGE AND HEIGHT ESTIMATION SYSTEM
# ==========================================

# Backend Settings
SECRET_KEY=change-this-in-production-12345
DATABASE_URL=sqlite:///./data/crop_estimation.db
FRONTEND_URL=http://localhost:8501

# Runtime Environment & Data Mode
APP_ENV=production
ENVIRONMENT=production
MOCK_DATA=false

# Satellite Provider
# Set to 'gee' (Live Google Earth Engine -> Microsoft Planetary Computer -> Real Local Cache)
SATELLITE_PROVIDER=gee

# Google & Gemini Credentials (leave blank or load from secure environment)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Frontend Settings
API_BASE_URL=http://127.0.0.1:8000/api/v1
