# ==========================================
# CROP ACREAGE AND HEIGHT ESTIMATION SYSTEM
# ==========================================

# Backend Settings
# Generate a secure key for production
SECRET_KEY=change-this-in-production-12345
DATABASE_URL=sqlite:///./data/crop_estimation.db
FRONTEND_URL=http://localhost:8501

# Satellite Provider
# Set to 'gee' for Real Google Earth Engine, or 'mock' for Demo mode
SATELLITE_PROVIDER=mock

# GEE Credentials (Required if SATELLITE_PROVIDER=gee)
GEE_PROJECT=your-gee-project-id
GEE_SERVICE_ACCOUNT=your-service-account@developer.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/app/secrets/gee_private_key.json

# Frontend Settings
API_BASE_URL=http://127.0.0.1:8000/api/v1
